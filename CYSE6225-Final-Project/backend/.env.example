# Copy this file to `.env` and adjust for your machine.
# `.env` is gitignored, so each teammate keeps their own settings.

# ---- Local DynamoDB (DynamoDB Local via Docker) ----
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT_URL=http://localhost:8000
# DynamoDB Local ignores the real values but boto3 still needs *some* creds:
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- Per-developer isolation ----
# IMPORTANT: give each teammate a UNIQUE prefix so your data never overlaps.
# e.g. jinkun_ , alice_ , bob_   (tables become jinkun_Users, alice_Users, ...)
TABLE_PREFIX=jinkun_

# ---- App ----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=*
PORT=5001
